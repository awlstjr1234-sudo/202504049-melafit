# 로컬 테스트 시 프론트엔드와 백엔드를 같은 호스트에서 실행하는 경우
# FRONTEND_URL과 BACKEND_URL을 동일하게 설정합니다.
FRONTEND_URL=http://localhost:5000
BACKEND_URL=http://localhost:5000
MONGODB_URI=mongodb://localhost:27017/mealfit
JWT_SECRET=your_super_secret_key_change_in_production_12345
JWT_EXPIRE=7d

# 각 소셜 로그인 제공업체 콘솔에서 아래 콜백 URL을 등록해야 합니다.
# Kakao: http://localhost:5000/api/auth/kakao/callback
# Naver: http://localhost:5000/api/auth/naver/callback
# Google: http://localhost:5000/api/auth/google/callback
KAKAO_CLIENT_ID=
KAKAO_CLIENT_SECRET=
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
